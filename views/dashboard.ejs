<div style="margin-bottom: 2rem;">
  <h2>Welcome to the Smart Campus Resource Portal</h2>
  <p style="color: var(--text-light); margin-top: 0.5rem;">Access study materials, previous year questions, placement prep, and more.</p>
</div>

<div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
  <form action="/resources" method="GET" style="display: flex; gap: 0.5rem; flex: 1;">
    <input type="text" name="search" placeholder="Search resources..." class="form-control" style="flex: 1;" />
    <button type="submit" class="btn btn-primary">Search</button>
  </form>
</div>

<h3 style="margin-bottom: 1rem;">Recent Uploads</h3>
<div class="grid grid-cols-3">
  <% if(resources.length === 0) { %>
    <p>No resources available yet.</p>
  <% } else { %>
    <% resources.forEach(resource => { %>
      <div class="card">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span class="badge badge-approved"><%= resource.category %></span>
          <span style="font-size: 0.75rem; color: var(--text-light);"><%= resource.downloads %> downloads</span>
        </div>
        <h4 style="margin-bottom: 0.5rem;"><%= resource.title %></h4>
        <p style="font-size: 0.875rem; color: var(--text-light); margin-bottom: 1rem;"><%= resource.description %></p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <a href="<%= resource.fileUrl %>" target="_blank" class="btn btn-primary" style="font-size: 0.875rem;" onclick="trackDownload('<%= resource._id %>')">Download</a>
          <span style="font-size: 0.75rem;">By <%= resource.uploader.name %></span>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script>
  async function trackDownload(id) {
    try {
      await fetch(`/api/resources/${id}/download`, { method: 'POST' });
    } catch (e) { console.log(e); }
  }
</script>
