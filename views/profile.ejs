<div class="card" style="margin-bottom: 2rem;">
  <h2><%= user.name %>'s Profile</h2>
  <p style="color: var(--text-light); margin-top: 0.5rem;">Email: <%= user.email %></p>
  <p style="color: var(--text-light);">Role: <span style="font-weight: 600;"><%= user.role %></span></p>
</div>

<h3 style="margin-bottom: 1rem;">My Uploaded Resources</h3>
<div class="grid grid-cols-3" style="margin-bottom: 2rem;">
  <% if(myUploads.length === 0) { %>
    <p>You haven't uploaded any resources yet.</p>
  <% } else { %>
    <% myUploads.forEach(resource => { %>
      <div class="card">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span class="badge badge-<%= resource.status === 'approved' ? 'approved' : 'pending' %>"><%= resource.status %></span>
          <span class="badge badge-approved"><%= resource.category %></span>
        </div>
        <h4 style="margin-bottom: 0.5rem;"><%= resource.title %></h4>
        <p style="font-size: 0.875rem; color: var(--text-light);"><%= resource.downloads %> downloads</p>
      </div>
    <% }) %>
  <% } %>
</div>

<h3 style="margin-bottom: 1rem;">Saved/Bookmarked Resources</h3>
<div class="grid grid-cols-3">
  <% if(user.savedResources.length === 0) { %>
    <p>No saved resources.</p>
  <% } else { %>
    <% user.savedResources.forEach(resource => { %>
      <div class="card">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span class="badge badge-approved"><%= resource.category %></span>
        </div>
        <h4 style="margin-bottom: 0.5rem;"><%= resource.title %></h4>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
          <a href="<%= resource.fileUrl %>" target="_blank" class="btn btn-primary" style="font-size: 0.875rem;">Download</a>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
