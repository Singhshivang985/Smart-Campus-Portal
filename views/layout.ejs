<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Smart Campus Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #0284c7; /* Sky Blue - very common for education */
      --primary-hover: #0369a1;
      --bg: #f8fafc; /* Very light slate */
      --card-bg: #ffffff;
      --text: #334155; /* Dark slate text */
      --text-light: #64748b;
      --white: #ffffff;
      --border: #e2e8f0;
      --success: #10B981;
      --danger: #EF4444;
      --warning: #F59E0B;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Nunito', sans-serif; }
    body { background-color: var(--bg); color: var(--text); display: flex; flex-direction: column; min-height: 100vh; }
    
    header { background-color: var(--white); border-bottom: 1px solid var(--border); padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 2px rgba(0,0,0,0.03); }
    header h1 { font-size: 1.5rem; font-weight: 700; color: var(--primary); letter-spacing: -0.5px; }
    header nav { display: flex; gap: 1.5rem; align-items: center; }
    header a { text-decoration: none; color: var(--text); font-weight: 600; transition: color 0.2s; }
    header a:hover { color: var(--primary); }
    
    main { flex: 1; padding: 2.5rem 2rem; max-width: 1200px; margin: 0 auto; width: 100%; }
    
    .btn { display: inline-block; padding: 0.6rem 1.25rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s ease; }
    .btn-primary { background-color: var(--primary); color: var(--white); box-shadow: 0 4px 6px -1px rgba(2, 132, 199, 0.2); }
    .btn-primary:hover { background-color: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 6px 8px -1px rgba(2, 132, 199, 0.3); }
    .btn-outline { border: 2px solid var(--primary); color: var(--primary); background: transparent; }
    .btn-outline:hover { background-color: var(--primary); color: var(--white); }
    .btn-danger { background-color: var(--danger); color: white; }
    .btn-success { background-color: var(--success); color: white; }

    .card { background: var(--card-bg); border-radius: 0.75rem; padding: 1.75rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s; }
    .card:hover { transform: translateY(-3px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.04); }
    
    .grid { display: grid; gap: 1.75rem; }
    .grid-cols-3 { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
    
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text); }
    .form-control { width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; font-family: inherit; font-size: 1rem; transition: border-color 0.2s; }
    .form-control:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.1); }
    
    .badge { padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-pending { background: #fef3c7; color: #b45309; }
    .badge-approved { background: #e0f2fe; color: #0369a1; }

    footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border); background: var(--card-bg); margin-top: auto; color: var(--text-light); font-weight: 500; }
  </style>
</head>
<body>

  <header>
    <h1><a href="/" style="color: var(--primary);">Smart Campus Portal</a></h1>
    <nav>
      <a href="/resources">Resources</a>
      <% if (locals.user) { %>
        <a href="/upload">Upload</a>
        <a href="/profile">Profile</a>
        <% if (locals.user.role === 'Admin' || locals.user.role === 'Faculty') { %>
          <a href="/admin">Admin Panel</a>
        <% } %>
        <button class="btn btn-outline" style="padding: 0.4rem 1rem;" id="logoutBtn">Logout</button>
      <% } else { %>
        <a href="/login" class="btn btn-outline" style="padding: 0.4rem 1rem;">Login</a>
        <a href="/signup" class="btn btn-primary" style="padding: 0.4rem 1rem;">Sign Up</a>
      <% } %>
    </nav>
  </header>

  <main>
    <%- body %>
  </main>

  <footer>
    <p>&copy; 2026 Smart Campus Resource Portal. Made by shivang985</p>
  </footer>

  <script>
    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        try {
          const res = await fetch('/api/auth/logout', { method: 'GET' });
          if (res.ok) location.assign('/');
        } catch (err) {
          console.error(err);
        }
      });
    }
  </script>
</body>
</html>
